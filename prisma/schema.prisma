// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}
 
datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model EntityType {
  id_entity_type   Int      @id @default(autoincrement())
  name_entity_type String   @unique @db.VarChar(100)
  entities         Entity[]
}

model Entity {
  id_entity      Int        @id @default(autoincrement())
  id_entity_type Int
  entity_type    EntityType @relation(fields: [id_entity_type], references: [id_entity_type])

  // Relaciones de transacciones
  transactions_as_old_owner Transaction[] @relation("OldOwner")
  transactions_as_new_owner Transaction[] @relation("NewOwner")
  transaction_entities      TransactionEntity[]

  // Relaciones uno a uno con otras entidades
  item     Item?
  resource Resource?
  branch   Branch?
  area     Area?
  user     User?

  // Relaciones de propiedad entre entidades
  entities_owned EntityOwnership[] @relation("EntityOwners")
  entities_owner EntityOwnership[] @relation("EntityOwned")
}

model EntityOwnership {
  id_owner_entity     Int
  id_owned_entity     Int
  amount              Int

  owner_entity Entity @relation("EntityOwners", fields: [id_owner_entity], references: [id_entity])
  owned_entity Entity @relation("EntityOwned",  fields: [id_owned_entity], references: [id_entity])

  @@id([id_owner_entity, id_owned_entity])
}

model Transaction {
  id_transaction   Int       @id @default(autoincrement())
  date_transaction DateTime  @default(now())
  id_old_owner     Int
  id_new_owner     Int
  amount           Decimal?  @db.Decimal(10, 2)

  old_owner Entity @relation("OldOwner", fields: [id_old_owner], references: [id_entity])
  new_owner Entity @relation("NewOwner", fields: [id_new_owner], references: [id_entity])

  transaction_entities TransactionEntity[]
}

model TransactionEntity {
  id_transaction Int
  id_entity      Int

  transaction Transaction @relation(fields: [id_transaction], references: [id_transaction])
  entity      Entity      @relation(fields: [id_entity], references: [id_entity])

  @@id([id_transaction, id_entity])
}

model ItemType {
  id_item_type Int    @id @default(autoincrement())
  name         String @unique @db.VarChar(100)
  items        Item[]
}

model Item {
  id_item      String   @id
  id_item_type Int
  name_item    String   @db.VarChar(255)
  description  String?
  provider     String
  id_entity    Int      @unique

  item_type ItemType @relation(fields: [id_item_type], references: [id_item_type])
  entity    Entity   @relation(fields: [id_entity], references: [id_entity])
}

model Resource {
  id_resource  Int     @id @default(autoincrement())
  name_resource String @db.VarChar(255)
  description   String?
  id_entity     Int     @unique

  entity Entity @relation(fields: [id_entity], references: [id_entity])
}

model Area {
  id_area   Int    @id @default(autoincrement())
  name_area String @db.VarChar(255)
  location  String?
  id_entity Int     @unique

  entity Entity @relation(fields: [id_entity], references: [id_entity])
}

model Branch {
  id_branch   Int    @id @default(autoincrement())
  name_branch String @db.VarChar(255)
  location    String?
  phone       String?
  id_entity   Int     @unique

  entity Entity @relation(fields: [id_entity], references: [id_entity])
}

model UserRole {
  id_user_role   Int    @id @default(autoincrement())
  name_user_role String @unique @db.VarChar(100)
  users          User[]
}

model User {
  id_user      Int    @id @default(autoincrement())
  name_user    String @db.VarChar(255)
  email        String @unique @db.VarChar(255)
  id_user_role Int
  id_entity    Int @unique

  user_role UserRole @relation(fields: [id_user_role], references: [id_user_role])
  entity    Entity   @relation(fields: [id_entity], references: [id_entity])
}