generator client {
  provider = "prisma-client-js"
}
 
datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model Entity {
  id_entity      Int        @id @default(autoincrement())
  entity_type    Int

  // Relaciones de transacciones
  transactions_as_old_owner Transaction[] @relation("OldOwner")
  transactions_as_new_owner Transaction[] @relation("NewOwner")
  transaction_entities      TransactionEntity[]

  // Relaciones uno a uno con otras entidades
  item     Item?
  resource Resource?
  branch   Branch?
  area     Area?
  user     User?

  // Relaciones de propiedad entre entidades
  entities_owned EntityOwnership[] @relation("EntityOwners")
  entities_owner EntityOwnership[] @relation("EntityOwned")
}

model EntityOwnership {
  id_owner_entity     Int
  id_owned_entity     Int
  amount              Int

  owner_entity Entity @relation("EntityOwners", fields: [id_owner_entity], references: [id_entity])
  owned_entity Entity @relation("EntityOwned",  fields: [id_owned_entity], references: [id_entity])

  @@id([id_owner_entity, id_owned_entity])
}

model Transaction {
  transaction_id   Int       @id @default(autoincrement())
  transaction_date DateTime  @default(now())
  old_owner_id     Int
  new_owner_id     Int
  amount           Decimal   @db.Decimal(10, 2)

  old_owner Entity @relation("OldOwner", fields: [old_owner_id], references: [id_entity])
  new_owner Entity @relation("NewOwner", fields: [new_owner_id], references: [id_entity])

  transaction_entities TransactionEntity[]
}

model TransactionEntity {
  transaction_id Int
  id_entity      Int

  transaction Transaction @relation(fields: [transaction_id], references: [transaction_id])
  entity      Entity      @relation(fields: [id_entity], references: [id_entity])

  @@id([transaction_id, id_entity])
}

model ItemType {
  id_item_type Int    @id @default(autoincrement())
  name         String @unique @db.VarChar(100)
  items        Item[]
}

model Item {
  id_item      String   @id
  name_item    String   @db.VarChar(255)
  description  String
  provider     String   @db.VarChar(255)
  id_item_type Int
  id_entity    Int      @unique

  item_type ItemType @relation(fields: [id_item_type], references: [id_item_type])
  entity    Entity   @relation(fields: [id_entity], references: [id_entity])
}

model Resource {
  resource_id   String  @id
  resourcename  String  @db.VarChar(255)
  measure       String  @db.VarChar(100)
  currency      String  @db.VarChar(10)
  description   String
  id_entity     Int     @unique

  entity Entity @relation(fields: [id_entity], references: [id_entity])
}

model Area {
  area_id          String  @id
  areaname         String  @db.VarChar(255)
  pattern_area_id  String  
  branch_id        String  @db.VarChar(100)
  phone            String  @db.VarChar(20)
  description      String
  active           Boolean @default(true)
  id_entity        Int     @unique

  entity Entity @relation(fields: [id_entity], references: [id_entity])
  pattern_area Area?  @relation("AreaPattern", fields: [pattern_area_id], references: [area_id])
  child_areas  Area[] @relation("AreaPattern")
}

model Branch {
  id_branch    String  @id
  name_branch  String  @db.VarChar(255)
  city         String  @db.VarChar(100)
  phone        String  @db.VarChar(20)
  state        Boolean @default(true)
  id_entity    Int     @unique

  entity Entity @relation(fields: [id_entity], references: [id_entity])
}

model UserRole {
  id_user_rol    Int    @id @default(autoincrement())
  name_user_rol  String @unique @db.VarChar(100)
  user_roles     UserUserRole[]
}

model User {
  user_id    String @id
  username   String @db.VarChar(100)
  email      String @unique @db.VarChar(255)
  password   String @db.VarChar(255)
  id_entity  Int    @unique

  entity     Entity         @relation(fields: [id_entity], references: [id_entity])
  user_roles UserUserRole[]
}

model UserUserRole {
  user_id      String
  id_user_rol  Int

  user      User     @relation(fields: [user_id], references: [user_id])
  user_role UserRole @relation(fields: [id_user_rol], references: [id_user_rol])

  @@id([user_id, id_user_rol])
}